{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-loopback",
  "description": "Allows the TowerForge Studio loopback page to receive native desktop menu events.",
  "windows": ["main"],
  "local": true,
  "remote": {
    "urls": ["http://127.0.0.1:*/*"]
  },
  "permissions": [
    "core:event:allow-listen",
    "allow-desktop-sync-ui-state",
    "allow-desktop-choose-project-parent",
    "allow-desktop-create-project",
    "allow-desktop-import-remix",
    "allow-desktop-open-project",
    "allow-desktop-open-recent",
    "allow-desktop-open-external",
    "allow-desktop-finish-lifecycle"
  ]
}
